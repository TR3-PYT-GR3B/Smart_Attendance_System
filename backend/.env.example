# Local defaults. Never place real credentials in this file.
DEPLOYMENT_TARGET=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-me-for-any-non-debug-environment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Supabase PostgreSQL Session Pooler URL (port 5432 is preferred).
DATABASE_URL=postgresql://postgres.project-ref:password@host.pooler.supabase.com:5432/postgres
DATABASE_SSL_REQUIRE=True

# Private Supabase Storage bucket through the S3-compatible endpoint.
SUPABASE_STORAGE_ENABLED=False
SUPABASE_STORAGE_BUCKET=attendx-private
SUPABASE_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=project-region
SUPABASE_S3_ACCESS_KEY_ID=replace-me
SUPABASE_S3_SECRET_ACCESS_KEY=replace-me

# Optional one-time/idempotent administrator bootstrap.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-long-unique-password
