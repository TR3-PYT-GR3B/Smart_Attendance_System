# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ── Virtual environments ──
venv
.venv/
env/
ENV/

# ── Environment / secrets ──
.env
.env.*
!backend/.env.example

# Android signing material is local/secret; only the documented template is tracked.
frontend/attendx/android/key.properties
frontend/attendx/android/*.jks
frontend/attendx/android/*.keystore

# ── Django ──
db.sqlite3
db.sqlite3-journal
*.log
staticfiles/

# Media uploads: worker documents, enrolment / verification captures.
# These contain personal and biometric data — never commit them.
media/

# Local diagnostic captures may contain settings and request data.
backend/debug/

# Local pre-refactor archives, if explicitly created later.
BACKUP/

# ── ML model weights (downloaded separately, large binaries) ──
ml_models/
*.onnx

# ── Testing / coverage ──
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# ── Editors & OS ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
